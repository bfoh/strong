# Supabase server access. Never prefix the service-role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set the verified production origin before building (e.g. https://your-domain).
NEXT_PUBLIC_SITE_URL=

# Only fill with company-confirmed details; never copy TV screenshot overlays.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Optional modern key aliases (legacy ANON/SERVICE_ROLE names above remain supported).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live QA only: remove these local credentials after password-login verification.
LIVE_TEST_ADMIN_EMAIL=
LIVE_TEST_ADMIN_PASSWORD=
# Production defaults to requiring the atomic quota SQL migration.
# Only use the legacy limiter override temporarily in a controlled environment.
ALLOW_LEGACY_LEAD_LIMIT=
# Optional verified social profile URLs (https://...). Leave unset to hide.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
