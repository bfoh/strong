# Supabase server access. Never prefix the service-role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set the verified production origin before building (e.g. https://your-domain).
NEXT_PUBLIC_SITE_URL=

# Optional local-only /preview/house route in production mode.
# The public homepage at / works without this flag.
STRONG_HOUSE_LOCAL_PREVIEW=

# Only fill with company-confirmed details; never copy TV screenshot overlays.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_INTERNATIONAL_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Optional modern key aliases (legacy ANON/SERVICE_ROLE names above remain supported).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live QA only: remove these local credentials after password-login verification.
LIVE_TEST_ADMIN_EMAIL=
LIVE_TEST_ADMIN_PASSWORD=
# Optional Google measurement; tags load only after opt-in.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Emergency static hero switch (1 = static; rebuild required).
NEXT_PUBLIC_HERO_STATIC=

# Missing atomic SQL quota RPC falls back to create-only reservations in the
# verified private strong-homepage-private bucket. No legacy count limiter.
# Optional verified social profile URLs (https://...). Leave unset to hide.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
